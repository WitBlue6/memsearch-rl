# Copy to configs/experiment.local.env. This is sourced by bash; use trusted files only.
# Model choices live here, not in workflow commands. Local paths may contain spaces.
EXPERIMENT_ID=experiment-001
READER_REPO=Qwen/Qwen2.5-7B-Instruct
READER_MODEL="$HOME/models/Qwen2.5-7B-Instruct"
POLICY_REPO="$READER_REPO"
POLICY_MODEL="$READER_MODEL"
# Keep the budget tokenizer fixed when comparing model sizes.
BUDGET_TOKENIZER="$POLICY_MODEL"
SERVING_ENV="$HOME/venvs/memsearch-serving"
READER_GPU=6
READER_PORT=8000
MEMORY_GPU=7
MEMORY_PORT=8001
TRAIN_GPUS=0,1,2,3,4,5
TRAIN_PROCESSES=6
MAX_MODEL_LEN=6144
GPU_MEMORY_UTILIZATION=0.85
MAX_NUM_SEQS=2
MAX_NEW=512
TRAIN_DATA=data/processed/train-001
DEV_DATA=data/processed/dev-001
SMOKE_DATA=data/processed/dev-smoke-002
# Set to a merged checkpoint before serving/evaluating after training.
MEMORY_MODEL="checkpoints/$EXPERIMENT_ID"

# Opt-in vLLM reader-only JSON decoding; use a new experiment ID when changing.
READER_OUTPUT=json_schema

# Shared memory schema in API evaluation and local GRPO; requires Linux structured extra.
MEMORY_OUTPUT=json_schema
